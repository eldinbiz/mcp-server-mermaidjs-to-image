{
  "name": "mcp-mermaidjs-to-image",
  "version": "0.1.0",
  "description": "MCP server tool for rendering Mermaid.js syntax into high-resolution PNG images with verbose AI error diagnostics",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-mermaidjs-to-image": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "node --import tsx test/test-render.ts && node --import tsx test/test-mcp-stdio.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mermaid",
    "mermaidjs",
    "png",
    "diagram",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "mermaid": "^12.2.0",
    "puppeteer": "^24.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
